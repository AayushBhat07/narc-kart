# NARC KART - Vercel environment template
#
# Copy these names into Vercel Project Settings -> Environment Variables.
# Do not commit real values. Leave VITE_API_BASE unset for the current
# fully static deployment path described in README.md.

# Optional: only set this when the React app should call a live API.
# Examples:
# VITE_API_BASE=/api
# VITE_API_BASE=https://narc-kart-api.example.com
VITE_API_BASE=

# Required only when enabling the Vercel serverless API routes in frontend/api.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: protects the /api/scrape endpoint when set.
CRON_SECRET=

