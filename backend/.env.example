# Narc Kart Backend - Environment Variables
# Copy this to .env and fill in your values

# ─── CORS / Frontend ───────────────────────────────────────
# Your Vercel frontend URL (e.g., narc-kart.vercel.app or your-project.vercel.app)
VERCEL_FRONTEND_URL=narc-kart.vercel.app

# Cloudflare tunnel URL (if using cloudflared to expose local dev)
# CLOUDFLARE_TUNNEL_URL=https://your-tunnel.trycloudflare.com

# ─── Database ──────────────────────────────────────────────
# Path to the SQLite database file
DATABASE_PATH=narc_kart.db
# Legacy FastAPI backend path override used by backend/main.py
NARC_KART_DB=narc_kart.db

# ─── Ollama (AI) ───────────────────────────────────────────
# URL for local Ollama instance (default: http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:latest

# ─── Geocoding ─────────────────────────────────────────────
# Nominatim (OpenStreetMap) geocoding - rate limited, use responsibly
# GEOCODER_USE_CACHE=true

# ─── Scraping ──────────────────────────────────────────────
# Number of concurrent scrape workers
# SCRAPE_WORKERS=4

# ─── Application ───────────────────────────────────────────
# Port for local dev server (default: 8000)
# NARC_KART_PORT=8000
# Host to bind to (default: 0.0.0.0)
# NARC_KART_HOST=0.0.0.0
